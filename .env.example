# Supabase Postgres via the transaction pooler (port 6543), using the careslot_app role.
DATABASE_URL=postgresql://careslot_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Public base URL of the site (used as the OAuth issuer for the Claude connector).
PUBLIC_URL=http://localhost:3000
# Optional: protects /api/cron (Vercel sends it automatically when set).
CRON_SECRET=
