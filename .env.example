# Supabase Postgres via the session pooler (port 5432), using the careslot_app role.
DATABASE_URL=postgresql://careslot_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Public base URL of the site (used as the OAuth issuer for the Claude connector).
PUBLIC_URL=http://localhost:3000
# Optional: protects /api/cron (Vercel sends it automatically when set).
CRON_SECRET=
# Optional: time zone for 'today'/'now' (default Asia/Kolkata).
APP_TIMEZONE=Asia/Kolkata
